{
  "name": "@0xkey-io/pay",
  "version": "1.0.0-rc.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js",
      "default": "./dist/client/index.mjs"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.mjs"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.mjs",
      "require": "./dist/express/index.js",
      "default": "./dist/express/index.mjs"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.mjs",
      "require": "./dist/hono/index.js",
      "default": "./dist/hono/index.mjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.mjs",
      "require": "./dist/next/index.js",
      "default": "./dist/next/index.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "description": "0xkey x402 / stablecoin payment SDK for agents and merchants",
  "keywords": [
    "0xkey",
    "x402",
    "payment",
    "stablecoin",
    "agent"
  ],
  "files": [
    "dist/",
    "docs/",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "build": "rollup -c",
    "clean": "rimraf ./dist ./.cache",
    "artifact:check": "node scripts/check-packed-artifact.mjs",
    "artifact:test": "node --test scripts/check-packed-artifact.test.mjs",
    "docs:generate": "node scripts/generate-doc-facts.mjs",
    "docs:check": "pnpm run docs:generate && node scripts/check-docs.mjs && git diff --exit-code -- docs/generated-support.md",
    "pins:check": "node scripts/check-exact-pins.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --allowJs false --checkJs false",
    "typecheck:pay-v1": "tsc -p tsconfig.pay-v1.json --allowJs false --checkJs false",
    "test": "jest --detectOpenHandles",
    "test:client-boundary": "pnpm run build && node --test scripts/client-boundary-real.test.mjs",
    "test:pay-v1": "jest --detectOpenHandles --runInBand src/client.test.ts src/server.test.ts src/admin/index.test.ts src/xstamp.test.ts src/frameworks.test.ts",
    "test:interop": "pnpm run clean && pnpm run build && node scripts/interop-smoke.mjs && node scripts/mppx-validate-smoke.mjs",
    "test:commerce-contract": "jest --runInBand src/commerce/generated/codec.test.ts"
  },
  "peerDependencies": {
    "viem": ">=2.54.0 <3"
  },
  "dependencies": {
    "@0xkey-io/crypto": "workspace:*",
    "@0xkey-io/viem": "workspace:*",
    "@0xkey-io/http": "workspace:*",
    "@0xkey-io/api-key-stamper": "workspace:*",
    "@x402/core": "2.22.0",
    "@x402/evm": "2.22.0",
    "@x402/fetch": "2.22.0",
    "ajv": "8.12.0",
    "mppx": "0.8.17"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/express": "^4.17.21",
    "jest": "^29.3.1",
    "ts-jest": "29.4.1",
    "typescript": "5.4.3",
    "viem": "2.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
