# 0xkey staging. Every value here is public; never add API keys or secrets.
EXPO_PUBLIC_ZEROXKEY_ORGANIZATION_ID=your-organization-id
EXPO_PUBLIC_ZEROXKEY_API_BASE_URL=https://api.staging.0xkey.io
EXPO_PUBLIC_ZEROXKEY_AUTH_PROXY_URL=https://authproxy.staging.0xkey.io
EXPO_PUBLIC_ZEROXKEY_AUTH_PROXY_CONFIG_ID=your-auth-proxy-config-id
# Passkey relying party ID. Must serve apple-app-site-association and
# assetlinks.json for this app; also used for the iOS associated domain.
EXPO_PUBLIC_ZEROXKEY_RPID=your-rp-id-domain
EXPO_PUBLIC_APP_SCHEME=withreactnativewalletkit

# Optional: OAuth relay. Defaults to https://oauth-redirect.0xkey.io/
# EXPO_PUBLIC_OAUTH_REDIRECT_URI=
# Optional: OAuth client IDs. Providers without an ID are disabled.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICE_ID=
EXPO_PUBLIC_APPLE_BUNDLE_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_ID=
EXPO_PUBLIC_X_CLIENT_ID=
EXPO_PUBLIC_DISCORD_CLIENT_ID=

# Build-time native identity (read by app.config.js, not bundled).
ZEROXKEY_DEMO_APPLE_TEAM_ID=
ZEROXKEY_DEMO_IOS_BUNDLE_ID=
ZEROXKEY_DEMO_ANDROID_PACKAGE=
