# ZeroXKey API credentials
API_PUBLIC_KEY="<0xkey API public key starting with 02 or 03>"
API_PRIVATE_KEY="<0xkey API private key>"
BASE_URL="https://api.0xkey.io"
ORGANIZATION_ID="<Your 0xkey organization ID>"

# Required for wallet/key import operations
USER_ID="<0xkey user ID for import operations>"

# Required for fund sweeping (Path 1)
# The wallet address to sign transactions with (after import)
SIGN_WITH="<Ethereum address of imported wallet, e.g., 0x...>"
# Safe destination address for swept funds
SAFE_TREASURY_ADDRESS="<Destination address for swept funds, e.g., 0x...>"

# Optional: Alchemy API key for RPC (defaults to public RPC)
ALCHEMY_API_KEY="<Your Alchemy API key>"

# Path 2: Encryption Key Escrow
# The private key ID in ZeroXKey used for encryption (created during setup)
ENCRYPTION_KEY_ID="<Private key ID from 0xkey, e.g., pk-...>"
